<tr>
<td style="padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; border: 1px solid #000000; width: 12.3203%;" width="36">
<p>第一周</p>
</td>
<td style="padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; border: 1px solid #000000; width: 20.3286%;" width="123">
<p>语言中心生成式AI导论</p>
</td>
<td style="padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; border: 1px solid #000000; width: 34.2916%;" width="167">
